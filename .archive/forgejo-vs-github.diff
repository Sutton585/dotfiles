-                    except Exception:
-                        pass
-
-    else:
-        logger.info("mdformat formatting skipped per SANITIZE_MDFORMAT setting.")
-
-    result = result.strip()
-    logger.info(f"sanitize_description FINISHED. Final length: {len(result)}. Difference: {len(result) - original_length}")
-    
-    return result
